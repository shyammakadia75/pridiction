# ---------------------------------------------------------------------------
# Football Intelligence — example environment configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust values for your machine. NEVER commit a
# real ".env" file or any API keys, passwords, or tokens. No API key is
# required to initialize the project.
# ---------------------------------------------------------------------------

# Application environment: development | testing | production
FI_ENVIRONMENT=development

# SQLite database path. Relative paths resolve against the project root.
FI_DATABASE_PATH=data/football_intelligence.db

# Logging
FI_LOG_LEVEL=INFO
FI_LOG_DIR=logs
FI_LOG_FILE=football_intelligence.log
FI_LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s
